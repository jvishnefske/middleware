;; Every op of the core's subset, with results published on `r` (see
;; diff.rs and vectors.rs). 1-byte pages: 8 KiB growing to at most 8194
;; bytes, so memory.grow succeeds twice and then fails.
(module
  (import "mw" "publish" (func $pub (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 8192 8194 (pagesize 1))
  (table 3 funcref)
  (elem (i32.const 0) $dbl $neg)
  (global $g (mut i32) (i32.const 7))
  (data (i32.const 0) "r")
  (func $dbl (param i32) (result i32) (i32.shl (local.get 0) (i32.const 1)))
  (func $neg (param i32) (result i32) (i32.sub (i32.const 0) (local.get 0)))
  (func $out (param $v i32)
    (i32.store (i32.const 16) (local.get $v))
    (drop (call $pub (i32.const 0) (i32.const 1) (i32.const 16) (i32.const 4))))
  (func $fact (param $n i32) (result i32)
    (if (result i32) (i32.le_s (local.get $n) (i32.const 1))
      (then (i32.const 1))
      (else (i32.mul (local.get $n) (call $fact (i32.sub (local.get $n) (i32.const 1)))))))
  (func $sw (param $i i32) (result i32)
    (block $d (block $c (block $b (block $a
      (br_table $a $b $c $d (local.get $i)))
      (return (i32.const 100)))
      (return (i32.const 200)))
      (return (i32.const 300)))
    (i32.const 400))
  (func $loop (param $n i32) (result i32) (local $acc i32)
    (block $out (loop $l
      (br_if $out (i32.eqz (local.get $n)))
      (local.set $acc (i32.add (local.get $acc) (local.get $n)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br $l)))
    (local.get $acc))
  (func $blockval (param $x i32) (result i32)
    (block $b (result i32)
      (drop (br_if $b (i32.const 11) (local.get $x)))
      (i32.const 22)))
  (func (export "init") (local $i i32)
    (call $out (i32.add (i32.const 0x7fffffff) (i32.const 1)))
    (call $out (i32.div_s (i32.const -7) (i32.const 2)))
    (call $out (i32.div_u (i32.const -7) (i32.const 2)))
    (call $out (i32.rem_s (i32.const -7) (i32.const 2)))
    (call $out (i32.rem_u (i32.const -7) (i32.const 2)))
    (call $out (i32.shr_s (i32.const -256) (i32.const 36)))
    (call $out (i32.shr_u (i32.const -256) (i32.const 4)))
    (call $out (i32.rotl (i32.const 0x12345678) (i32.const 8)))
    (call $out (i32.rotr (i32.const 0x12345678) (i32.const 8)))
    (call $out (i32.clz (i32.const 0x00f00000)))
    (call $out (i32.ctz (i32.const 0x00f00000)))
    (call $out (i32.popcnt (i32.const -1)))
    (call $out (i32.extend8_s (i32.const 0x80)))
    (call $out (i32.extend16_s (i32.const 0x8000)))
    (call $out (i32.lt_u (i32.const -1) (i32.const 1)))
    (call $out (i32.lt_s (i32.const -1) (i32.const 1)))
    (call $out (i32.ge_u (i32.const 3) (i32.const 3)))
    (call $out (i32.xor (i32.const 0xff00) (i32.const 0x0ff0)))
    (call $out (call $fact (i32.const 10)))
    (local.set $i (i32.const 0))
    (loop $l
      (call $out (call $sw (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 6))))
    (call $out (call $loop (i32.const 100)))
    (call $out (call $blockval (i32.const 0)))
    (call $out (call $blockval (i32.const 1)))
    (call $out (call_indirect (param i32) (result i32) (i32.const 21) (i32.const 0)))
    (call $out (call_indirect (param i32) (result i32) (i32.const 21) (i32.const 1)))
    (call $out (select (i32.const 5) (i32.const 6) (i32.const 0)))
    (global.set $g (i32.mul (global.get $g) (i32.const 6)))
    (call $out (global.get $g))
    (i32.store8 (i32.const 100) (i32.const 0x1ff))
    (i32.store16 (i32.const 102) (i32.const 0x18001))
    (call $out (i32.load (i32.const 100)))
    (call $out (i32.load8_s (i32.const 100)))
    (call $out (i32.load16_s (i32.const 102)))
    (call $out (i32.load16_u offset=2 (i32.const 100)))
    (memory.fill (i32.const 200) (i32.const 0xab) (i32.const 10))
    (memory.copy (i32.const 205) (i32.const 198) (i32.const 10))
    (call $out (i32.load (i32.const 204)))
    (call $out (memory.size))
    (call $out (memory.grow (i32.const 1)))
    (call $out (memory.grow (i32.const 1)))
    (call $out (memory.size))
    (i64.store (i32.const 300) (i64.const 0x0102030405060708))
    (call $out (i32.load (i32.const 304))))
)
