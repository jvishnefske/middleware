/* RP2350A (Raspberry Pi Pico 2, 4 MiB QSPI flash, 520 KiB SRAM).
 *
 * FLASH is one firmware slot of the A/B flash map in src/layout.rs
 * (0x17E000 bytes: slot A at flash offset 0x002000, slot B at 0x180000).
 * The boot ROM maps the slot it boots at 0x10000000 through address
 * translation, so this one image runs from either slot. The partition
 * table, the update record, the payload store and the trust record lie
 * outside both slots and are never linked into. RAM is SRAM0-7 plus SRAM8
 * and SRAM9, contiguous.
 */
MEMORY {
    FLASH : ORIGIN = 0x10000000, LENGTH = 0x17E000
    RAM   : ORIGIN = 0x20000000, LENGTH = 0x82000
}

/* The first sector: the IMAGE_DEF block (flags 0x9021, the build's
 * version) at 0x200 and the sentinel block at 0xF00, both generated by
 * build.rs from src/ota/image.rs into $OUT_DIR, and _stext at 0x1000 so the
 * sector holds no code (the explicit buy rewrites it while the image runs).
 * embassy-rp emits no IMAGE_DEF of its own (feature imagedef-none). */
INCLUDE rp2350-image.x

SECTIONS {
    .bi_entries : ALIGN(4)
    {
        __bi_entries_start = .;
        KEEP(*(.bi_entries));
        . = ALIGN(4);
        __bi_entries_end = .;
    } > FLASH
} INSERT AFTER .text;
