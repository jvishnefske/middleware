// Generated by the middleware Blocks editor (profile badge).
// Payload ABI: middleware src/wasm_abi.rs. Compile with
// asc --runtime stub --use abort= -O --initialMemory 1 --maximumMemory 1
// then rewritten to 16384 bytes of 1-byte pages (bytePages.ts).

@external("mw", "publish")
declare function mw_publish(keyPtr: usize, keyLen: i32, dataPtr: usize, dataLen: i32): i32;
@external("mw", "subscribe")
declare function mw_subscribe(keyPtr: usize, keyLen: i32): i32;
@external("mw", "set_tick")
declare function mw_set_tick(periodMs: i32): i32;

// Receive buffer handed to the host by mw_alloc.
const RX: usize = memory.data(512);
// Text being built for publish, log and show text.
const TX_CAP: i32 = 512;
const TX: usize = memory.data(512);
let txLen: i32 = 0;
const DIGITS: usize = memory.data(11);
// 8 LEDs, R G B each, as published on badge/leds.
const LEDS: usize = memory.data(24);

// "badge/text"
const S0: usize = memory.data<u8>([98, 97, 100, 103, 101, 47, 116, 101, 120, 116]);
const S0_LEN: i32 = 10;
// "LED chase"
const S1: usize = memory.data<u8>([76, 69, 68, 32, 99, 104, 97, 115, 101]);
const S1_LEN: i32 = 9;
// "badge/pet"
const S2: usize = memory.data<u8>([98, 97, 100, 103, 101, 47, 112, 101, 116]);
const S2_LEN: i32 = 9;
// "\u0004"
const S3: usize = memory.data<u8>([4]);
const S3_LEN: i32 = 1;
// "badge/leds"
const S4: usize = memory.data<u8>([98, 97, 100, 103, 101, 47, 108, 101, 100, 115]);
const S4_LEN: i32 = 10;
// "button "
const S5: usize = memory.data<u8>([98, 117, 116, 116, 111, 110, 32]);
const S5_LEN: i32 = 7;
// "badge/buttons"
const S6: usize = memory.data<u8>([98, 97, 100, 103, 101, 47, 98, 117, 116, 116, 111, 110, 115]);
const S6_LEN: i32 = 13;

let slot0: i32 = -1;
// The message being handled.
let msgPtr: usize = 0;
let msgLen: i32 = 0;
let v_pos: i32 = 0;

// Appends len bytes at ptr to TX, up to its capacity.
function txBytes(ptr: usize, len: i32): void {
  const room = TX_CAP - txLen;
  const n = len < room ? len : room;
  for (let i = 0; i < n; i++) store<u8>(TX + <usize>(txLen + i), load<u8>(ptr + <usize>i));
  txLen += n > 0 ? n : 0;
}

// Appends n in decimal to TX.
function txNum(n: i32): void {
  let u: u32 = n < 0 ? <u32>(0 - n) : <u32>n;
  let p: i32 = 11;
  do {
    p--;
    store<u8>(DIGITS + <usize>p, <u8>(0x30 + u % 10));
    u /= 10;
  } while (u != 0);
  if (n < 0) {
    p--;
    store<u8>(DIGITS + <usize>p, 0x2d);
  }
  txBytes(DIGITS + <usize>p, 11 - p);
}

// Remainder with the sign of the divisor (Blockly's modulo); 0 for a zero divisor.
function rem(a: i32, b: i32): i32 {
  if (b == 0 || b == -1) return 0;
  const r = a % b;
  return r != 0 && (r < 0) != (b < 0) ? r + b : r;
}

function clamp(v: i32, lo: i32, hi: i32): i32 {
  return v < lo ? lo : v > hi ? hi : v;
}

// Sets LED i (taken modulo 8) in the LED buffer, channels clamped to 0..255.
function ledSet(i: i32, r: i32, g: i32, b: i32): void {
  const at = LEDS + <usize>((((i % 8) + 8) % 8) * 3);
  store<u8>(at, <u8>clamp(r, 0, 255));
  store<u8>(at + 1, <u8>clamp(g, 0, 255));
  store<u8>(at + 2, <u8>clamp(b, 0, 255));
}

function ledFill(r: i32, g: i32, b: i32): void {
  for (let i = 0; i < 8; i++) ledSet(i, r, g, b);
}

// TX length cut to at most max bytes on a UTF-8 character boundary.
function textCap(max: i32): i32 {
  if (txLen <= max) return txLen;
  let n = max;
  while (n > 0 && (load<u8>(TX + <usize>n) & 0xc0) == 0x80) n--;
  return n;
}

export function init(): void {
  slot0 = mw_subscribe(S6, S6_LEN);
  mw_set_tick(100);
  txLen = 0;
  txBytes(S1, S1_LEN);
  mw_publish(S0, S0_LEN, TX, textCap(256));
  mw_publish(S2, S2_LEN, S3, 1);
}

export function tick(nowMs: i32): void {
  {
    ledFill(0, 0, 0);
    ledSet(v_pos, 255, 0, 96);
    mw_publish(S4, S4_LEN, LEDS, 24);
    v_pos = rem((v_pos + 1), 8);
  }
}

// Returns the receive buffer, or 0 to decline a message that does not fit.
export function mw_alloc(len: i32): usize {
  return len < 0 || len > 512 ? 0 : RX;
}

export function on_message(slot: i32, ptr: usize, len: i32): void {
  msgPtr = ptr;
  msgLen = len;
  if (slot == slot0 && len >= 2) {
    const button = <i32>load<u8>(ptr);
    const pressed = <i32>load<u8>(ptr + 1);
    if (pressed == 1) {
      txLen = 0;
      txBytes(S5, S5_LEN);
      txNum(<i32>load<u8>(msgPtr));
      mw_publish(S0, S0_LEN, TX, textCap(256));
    }
  }
}
